[Unit]
Description=AstraPlusCar phone control
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/home/HwHiAiUser/E2E-Samples-ziyan/src/E2E-Sample/Car/python
ExecStart=/bin/bash /home/HwHiAiUser/E2E-Samples-ziyan/src/E2E-Sample/Car/python/start_phone.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
